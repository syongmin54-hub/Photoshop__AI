# LLM Provider: "gemini_oauth" (구글 로그인 구독 사용), "openai", "claude", "custom"
LLM_PROVIDER=gemini_oauth

# Gemini Model Settings
GEMINI_MODEL=gemini-2.0-flash

# (Optional) OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# (Optional) Anthropic Claude API Key
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# (Optional) Local Ollama / Custom Base URL
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_MODEL=llama3
